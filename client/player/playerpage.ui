    color: #111827;
    font-size: 16px;
    font-weight: 600;
}
QLabel#uploadDate,
QLabel#playNum,
QLabel#likeNum,
QLabel#videoDesc {
    color: #6b7280;
    font-size: 14px;
}
QPushButton {
    border: none;
    background: transparent;
}
QPushButton#minBtn {
    border-image: url(:/images/PlayPage/suoxiao.png);
}
QPushButton#quitBtn {
    border-image: url(:/images/PlayPage/quxiao.png);
}
QPushButton#userAvatar {
    border-image: url(:/images/PlayPage/touxiang.png);
}
QPushButton#speedBtn {
    color: #3eceff;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#speedBtn:hover {
    color: #23b6e6;
}
QPushButton#volumeBtn {
    border-image: url(:/images/PlayPage/shnegyin.png);
}
QLabel#playNumIcon {
    border-image: url(:/images/PlayPage/bofangliang.png);
}
QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: #2f343b;
}
QSlider::sub-page:horizontal {
    border-radius: 2px;
    background: #3eceff;
}
QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
    background: #3eceff;
}
